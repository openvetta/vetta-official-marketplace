{
  "schemaVersion": 2,
  "slug": "xiaohongshu-mcp",
  "version": "2.5.0",
  "runtime": {
    "kind": "managed-binary",
    "service": {
      "kind": "http-mcp",
      "path": "/mcp",
      "readyTimeoutMs": 300000
    },
    "platforms": {
      "win32-x64": {
        "url": "https://github.com/xpzouying/xiaohongshu-mcp/releases/download/v2.5.0/xiaohongshu-mcp-windows-amd64.exe",
        "sha256": "3578c9fcf3e7be0b79564aeceef8c4f38e0072d9357ca1f911ee14cd37bd454c",
        "archive": "file",
        "executable": "xiaohongshu-mcp-windows-amd64.exe"
      },
      "darwin-arm64": {
        "url": "https://github.com/xpzouying/xiaohongshu-mcp/releases/download/v2.5.0/xiaohongshu-mcp-darwin-arm64",
        "sha256": "3e32e08c3403d22a5efef2f06aa52630b458819fc54474cba23e896c7092c38e",
        "archive": "file",
        "executable": "xiaohongshu-mcp-darwin-arm64"
      },
      "linux-x64": {
        "url": "https://github.com/xpzouying/xiaohongshu-mcp/releases/download/v2.5.0/xiaohongshu-mcp-linux-amd64",
        "sha256": "2695820af3a924412c0e555042b81a2598d144342539d4ebea18b17d56c85fbf",
        "archive": "file",
        "executable": "xiaohongshu-mcp-linux-amd64"
      }
    }
  },
  "server": {
    "type": "stdio",
    "command": "${VETTA_MCP_EXECUTABLE}",
    "args": [
      "-port=:${VETTA_MCP_PORT}"
    ],
    "env": {
      "COOKIES_PATH": "${VETTA_MCP_DATA_DIR}/cookies.json"
    }
  },
  "parameters": [
    {
      "key": "XHS_PROXY",
      "label": "Proxy URL",
      "required": false,
      "secret": false,
      "placeholder": "http://127.0.0.1:7890"
    }
  ],
  "browserAuth": false,
  "setup": {
    "kind": "agent-tool",
    "tool": "get_login_qrcode",
    "completedWhen": {
      "dataFile": "cookies.json"
    }
  }
}
