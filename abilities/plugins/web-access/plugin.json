{
  "id": "web-access",
  "name": "%plugin.name%",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "web_access",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.tools.register",
    "agent.toolHandler.execute",
    "ui.slot.workspace-view",
    "ui.slot.ability-detail",
    "storage.read",
    "storage.write",
    "secrets.read",
    "secrets.write",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "*"
    ]
  },
  "guidingWords": [
    "%guidingWords.search%",
    "%guidingWords.compare%",
    "%guidingWords.read%"
  ],
  "description": "%plugin.description%",
  "author": "Vetta"
}
