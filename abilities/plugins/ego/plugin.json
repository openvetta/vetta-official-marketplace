{
  "id": "ego",
  "name": "%plugin.name%",
  "version": "0.1.0",
  "icon": "assets/icon.png",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "ego",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.skills.control",
    "agent.systemPrompt.write"
  ],
  "agent": {
    "systemPrompt": {
      "promptPaths": [
        "agent/prompts/prefer-ego-browser.md"
      ]
    },
    "skillPaths": [
      "agent/skills/ego-browser"
    ],
    "skillPresentation": {
      "defaultVisibility": "hidden",
      "skills": {
        "ego-browser": {
          "defaultVisibility": "visible",
          "displayName": "%skill.browser.name%",
          "displayDescription": "%skill.browser.description%"
        }
      }
    }
  },
  "guidingWords": [
    "%guidingWords.test%",
    "%guidingWords.login%",
    "%guidingWords.extract%"
  ],
  "description": "%plugin.description%",
  "author": "Vetta"
}
