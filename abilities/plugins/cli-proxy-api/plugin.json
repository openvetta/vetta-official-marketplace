{
  "id": "cli-proxy-api",
  "name": "%name%",
  "icon": "assets/nav-icon.png",
  "version": "1.11.0",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "cli_proxy_api",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "models.manage",
    "media.provider.register",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "proxy",
        "runtime": {
          "version": "8.0.17+gemini.1.0.5",
          "platforms": {
            "win32-x64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "fbac0be6fd4ac72e0df91c5fd9eac39246d0d8e356d1d624b2603bdf5859dea0",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "e712e4f2a6972b7a692c32fbc8cdf839fcde29428acc9ad98e26ff7212ac24ee",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "win32-arm64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "3246eb72ca172e82f5f13756b1b73fd1827d65ada4d7b4fc7cb226513ee0c229",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "80b229c61d10cb34c0279beb93190411d48b055c9bd6f67248c4069ee4f08caa",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "540148a4f01ee297dcb5c6c99df8dc9be68c011ead4ff0751dc8c41b5485ad80",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "575c8c5663df54dd6f9132f69795e5297967b5cee0ff500b585f866b1a5cd710",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "d4952068c413060e3a8c082cc616fee707c701a01bebec59c45903bce402be9d",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "3c771ff57e607b40bf95753e0ad2fb01127a296fe4cbff79b49116cd2327b5bb",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "b121a58ee643a7a76b1bf3f757bef75a99660d17fe5afe089bf8a5c1afcd90d3",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "b0b202ff9466c6e1f7170577b9a0eb6bd1f5d8069747fce215583faebd3fab73",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "b90e3ad0868cc45624dd0a259a1ebcc23ea7c7ba87426656bafeb4bd738dd7f4",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "4e792bd079c2e1bae0134ee5e009317dbff8439d8fbed808aefb84dc44eb098c",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            }
          }
        },
        "credentials": [
          {
            "id": "api-key",
            "bytes": 32
          },
          {
            "id": "management-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "dist/assets/config.yaml.tpl",
            "destination": "config.yaml",
            "mode": "render"
          }
        ],
        "process": {
          "args": [
            "--config",
            "${VETTA_SERVICE_CACHE_DIR}/config.yaml"
          ]
        },
        "health": {
          "path": "/v1/models",
          "credentialId": "api-key",
          "timeoutMs": 60000,
          "readiness": {
            "mode": "plugin"
          }
        }
      }
    ]
  },
  "description": "%description%",
  "author": "Vetta / Router For Me",
  "defaultLocale": "en"
}
