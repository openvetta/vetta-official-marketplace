{
  "id": "feishu",
  "name": "%name%",
  "version": "1.0.0",
  "pluginApiVersion": "^1.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "feishu",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "shell.openExternal",
    "agent.skills.control"
  ],
  "providers": {
    "cli": [
      {
        "id": "lark-cli",
        "command": "lark-cli",
        "probe": {
          "args": ["--version"],
          "timeoutMs": 10000
        },
        "install": {
          "command": "npx",
          "args": ["-y", "@larksuite/cli@latest", "install"],
          "timeoutMs": 600000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": ["agent/skills/feishu"]
  },
  "description": "%description%",
  "author": "Vetta / Lark Suite",
  "defaultLocale": "en"
}
