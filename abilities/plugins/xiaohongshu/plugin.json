{
  "id": "xiaohongshu",
  "name": "%name%",
  "icon": "assets/icon.png",
  "version": "1.0.7",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "styles": ["dist/style.css"],
  "moduleFederation": {
    "remoteName": "xiaohongshu",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.mcp.control",
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "secrets.read",
    "secrets.write",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": ["github.com", "release-assets.githubusercontent.com"]
  },
  "providers": {
    "services": [
      {
        "id": "xhs",
        "runtime": {
          "version": "2.5.0",
          "platforms": {
            "win32-x64": {
              "executable": "xiaohongshu-mcp-windows-amd64.exe",
              "artifacts": [{
                "sha256": "3578c9fcf3e7be0b79564aeceef8c4f38e0072d9357ca1f911ee14cd37bd454c",
                "archive": "file",
                "destination": "xiaohongshu-mcp-windows-amd64.exe"
              }]
            },
            "darwin-arm64": {
              "executable": "xiaohongshu-mcp-darwin-arm64",
              "artifacts": [{
                "sha256": "3e32e08c3403d22a5efef2f06aa52630b458819fc54474cba23e896c7092c38e",
                "archive": "file",
                "destination": "xiaohongshu-mcp-darwin-arm64"
              }]
            },
            "linux-x64": {
              "executable": "xiaohongshu-mcp-linux-amd64",
              "artifacts": [{
                "sha256": "2695820af3a924412c0e555042b81a2598d144342539d4ebea18b17d56c85fbf",
                "archive": "file",
                "destination": "xiaohongshu-mcp-linux-amd64"
              }]
            }
          }
        },
        "process": {
          "args": ["-port=:${VETTA_SERVICE_PORT}"],
          "env": { "COOKIES_PATH": "${VETTA_SERVICE_DATA_DIR}/cookies.json" }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "xiaohongshu": {
        "type": "service",
        "serviceId": "xhs",
        "path": "/mcp",
        "displayName": "%mcp.name%",
        "description": "%mcp.description%"
      }
    }
  },
  "description": "%description%",
  "author": "Vetta",
  "defaultLocale": "zh"
}
