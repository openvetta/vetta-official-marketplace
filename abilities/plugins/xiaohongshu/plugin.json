{
  "id": "xiaohongshu",
  "name": "%name%",
  "icon": "assets/icon.png",
  "version": "1.1.16",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "styles": ["dist/style.css"],
  "moduleFederation": {
    "remoteName": "xiaohongshu",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.mcp.control",
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "secrets.read",
    "secrets.write",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": ["github.com", "release-assets.githubusercontent.com"]
  },
  "providers": {
    "services": [
      {
        "id": "xhs",
        "runtime": {
          "kind": "host-node",
          "version": "1.1.16",
          "entry": "service/dist/main.js",
          "platforms": {
            "win32-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "c9ccba1c3c840abc186bf81d8f94a7e9c67fc4d5c7b7e06fc98d167cdfbe2e1c",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "c9ccba1c3c840abc186bf81d8f94a7e9c67fc4d5c7b7e06fc98d167cdfbe2e1c",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "linux-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "c9ccba1c3c840abc186bf81d8f94a7e9c67fc4d5c7b7e06fc98d167cdfbe2e1c",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "VETTA_SERVICE_PORT": "${VETTA_SERVICE_PORT}",
            "VETTA_SERVICE_DATA_DIR": "${VETTA_SERVICE_DATA_DIR}",
            "XHS_HEADLESS": "false"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "xiaohongshu": {
        "type": "service",
        "serviceId": "xhs",
        "path": "/mcp",
        "displayName": "Xiaohongshu tools",
        "description": "Use the active Xiaohongshu account for search, note and interaction operations."
      }
    }
  },
  "description": "%description%",
  "author": "Vetta",
  "defaultLocale": "zh"
}
